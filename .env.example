# ASTRABIO environment settings
#
# Copy this file to `.env` in the project root and fill in only what you need.
# Everything here is optional: with no keys set, ASTRA uses its built-in
# rule-based replies and the dashboard works fully offline.
#
# Never commit your real `.env` file (it is already in .gitignore).
#
# Lines starting with `#` are defaults from the code. Uncomment one only if
# you want to change it. Leaving a value blank (e.g. `PORT=`) breaks startup.

# --- AI provider ------------------------------------------------------------
# Which model rewords ASTRA's non-critical replies: groq, ollama, anthropic or none.
# If unset: Groq when a Groq key is present, else Anthropic when its key is
# present, else Ollama.
# ASTRA_LLM=none

# Seconds to wait for a model before falling back to the built-in rules.
# ASTRA_LLM_TIMEOUT=20

# --- Groq (https://console.groq.com) ----------------------------------------
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (local model, no internet needed) -------------------------------
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# --- Anthropic (https://console.anthropic.com) ------------------------------
ANTHROPIC_API_KEY=
# ASTRA_MODEL=claude-sonnet-4-6

# --- Voice: FreeTTS speech generation (/api/voice) --------------------------
VOICE_API_KEY=

# --- Moderation via RapidAPI (/api/moderate) --------------------------------
RAPIDAPI_KEY=

# --- Server -----------------------------------------------------------------
# PORT=5000
